htmlcov/

# Runtime state (lives in ~/.jarvis, never in the repo — listed for clarity)
# ~/.jarvis/config.json   (user config, may hold a personal name)
# ~/.jarvis/logs/         (run logs)
*.log

# Editor / IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
